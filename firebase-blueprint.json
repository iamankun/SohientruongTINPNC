{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Data collection category such as Triển Khai, Bảo Trì, or temporary extensible categories.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the category owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the category."
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "URL-safe identifier slug for the category."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Short description of what information is collected in this category."
        },
        "group": {
          "type": "string",
          "enum": ["core", "temporary"],
          "description": "Indicates whether this is a core category or a temporary extensible category."
        },
        "colorKey": {
          "type": "string",
          "enum": ["blue", "amber", "emerald", "violet", "rose", "slate"],
          "description": "Semantic color key for the category."
        },
        "iconKey": {
          "type": "string",
          "enum": ["rocket", "wrench", "clipboard", "check", "alert", "layers"],
          "description": "Icon identifier for the category."
        },
        "order": {
          "type": "number",
          "description": "Sort order index."
        },
        "fields": {
          "type": "array",
          "description": "List of custom field definitions for forms in this category (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "name",
        "slug",
        "description",
        "group",
        "colorKey",
        "iconKey",
        "order",
        "fields",
        "createdAt",
        "updatedAt"
      ]
    },
    "FieldRecord": {
      "title": "FieldRecord",
      "description": "An individual collected information entry belonging to a category.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the record owner."
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the parent Category."
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Cached category name at time of entry."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Primary title or task summary."
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Site, address, or customer location."
        },
        "contactName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Contact person or technician name."
        },
        "status": {
          "type": "string",
          "enum": ["moi", "dang_xu_ly", "hoan_thanh", "da_luu_tru"],
          "description": "Workflow state; da_luu_tru is terminal and immutable."
        },
        "priority": {
          "type": "string",
          "enum": ["thap", "trung_binh", "cao"],
          "description": "Priority level."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Detailed field notes."
        },
        "customData": {
          "type": "object",
          "description": "Dynamic category-specific field values (max 25 entries)."
        },
        "collectedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Collection date in YYYY-MM-DD format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "categoryId",
        "categoryName",
        "title",
        "location",
        "contactName",
        "status",
        "priority",
        "notes",
        "customData",
        "collectedDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User-owned data collection categories."
    },
    "/records/{recordId}": {
      "schema": { "$ref": "#/entities/FieldRecord" },
      "description": "User-owned collected field records linked to categories."
    }
  }
}
