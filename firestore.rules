rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isVerifiedUser() && request.auth.uid == ownerId;
    }

    function isRootAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ankun.n.m@gmail.com';
    }

    function isAdmin() {
      return isRootAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'slug', 'description', 'group',
          'colorKey', 'iconKey', 'order', 'fields', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'slug', 'description', 'group',
          'colorKey', 'iconKey', 'order', 'fields', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 50 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.description is string && data.description.size() <= 200
        && data.group in ['core', 'temporary']
        && data.colorKey in ['blue', 'amber', 'emerald', 'violet', 'rose', 'slate']
        && data.iconKey in ['rocket', 'wrench', 'clipboard', 'check', 'alert', 'layers']
        && data.order is number && data.order >= 0 && data.order <= 100
        && data.fields is list && data.fields.size() <= 20 && (data.fields.size() == 0 || data.fields[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecord(data) {
      return data.keys().hasAll([
          'ownerId', 'categoryId', 'categoryName', 'title', 'location',
          'contactName', 'status', 'priority', 'notes', 'customData',
          'collectedDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'categoryId', 'categoryName', 'title', 'location',
          'contactName', 'status', 'priority', 'notes', 'customData',
          'collectedDate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.location is string && data.location.size() <= 160
        && data.contactName is string && data.contactName.size() <= 100
        && data.status in ['moi', 'dang_xu_ly', 'hoan_thanh', 'da_luu_tru']
        && data.priority in ['thap', 'trung_binh', 'cao']
        && data.notes is string && data.notes.size() <= 2000
        && data.customData is map && data.customData.keys().size() <= 25
        && data.collectedDate is string && data.collectedDate.size() == 10 && data.collectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'addedByUid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'addedByUid', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == adminId
        && data.email is string && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 120
        && isValidId(data.addedByUid)
        && data.createdAt is timestamp;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isOwner(existing().ownerId) || isAdmin();
      allow create: if isValidId(categoryId)
        && isValidCategory(incoming())
        && isOwner(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId)
        && isValidCategory(incoming())
        && (isOwner(existing().ownerId) || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().slug == existing().slug
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'group', 'colorKey', 'iconKey', 'order', 'fields', 'updatedAt'
        ]);
      allow delete: if isValidId(categoryId) && (isOwner(existing().ownerId) || isAdmin());
    }

    match /records/{recordId} {
      allow get: if isValidId(recordId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isOwner(existing().ownerId) || isAdmin();
      allow create: if isValidId(recordId)
        && isValidRecord(incoming())
        && isOwner(incoming().ownerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && get(/databases/$(database)/documents/categories/$(incoming().categoryId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(recordId)
        && isValidRecord(incoming())
        && (isOwner(existing().ownerId) || isAdmin())
        && (existing().status != 'da_luu_tru' || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'categoryId', 'categoryName', 'title', 'location', 'contactName',
              'status', 'priority', 'notes', 'customData', 'collectedDate', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
            && (get(/databases/$(database)/documents/categories/$(incoming().categoryId)).data.ownerId == existing().ownerId || isAdmin())
          )
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isValidId(recordId) && (isOwner(existing().ownerId) || isAdmin());
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && ((isVerifiedUser() && request.auth.uid == adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId)
        && isAdmin()
        && isValidAdminDoc(incoming(), adminId)
        && incoming().addedByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId)
        && isAdmin()
        && adminId != request.auth.uid
        && existing().email != 'ankun.n.m@gmail.com';
    }
  }
}
